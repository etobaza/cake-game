--!strict
-- Lemon Cake's 42 DAT_Recipe rows, paired with the authored Cake models; coffee remains a Cake Game extra.
-- Ingredients, prices, categories and oven times follow the source. Levels and mixer/freezer timing are adaptations.

--[[ Services ]]--
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--[[ References ]]--
local _Shared = ReplicatedStorage.Shared
local _Configs = _Shared.Configs

--[[ Modules ]]--
local GameTypes = require(_Shared.GameTypes)
local Registry = require(_Shared.Registry)

-- The authored shape; Registry.Build stamps `id` onto every entry.
type RecipeDefinition = {
	name: string,
	station: GameTypes.StationKind,
	ingredients: { [string]: number },
	mixSeconds: number,
	-- 0 for recipes that finish on the mixer.
	cookSeconds: number,
	-- Window between ready and burnt. 0 means the dish never burns.
	burnSeconds: number,
	price: number,
	unlockLevel: number,
	-- Hotbar art. Until it is filled in the slot shows the name alone.
	icon: string?,
	asset: string?,
	category: string,
	order: number,
	-- Original table flags, including its dietary inconsistencies, are retained below.
	vegan: boolean,
	glutenFree: boolean,
}
export type RecipeEntry = RecipeDefinition & { id: string }

