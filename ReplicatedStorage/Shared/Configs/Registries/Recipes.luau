-- Art per station, shown for a recipe that has no icon of its own yet. Every screen that draws a
-- dish falls back to the same picture, so the fallback lives beside the rows.
local STATION_ICONS: { [string]: string } = {
	Oven = "rbxassetid://92476642419989",
	Mixer = "rbxassetid://95112718749723",
	Freezer = "rbxassetid://139638065759924",
	Coffee = "rbxassetid://95112718749723",
}

type RecipesMethods = {
	GetDirectRecipe: (self: RecipesRegistry, menu: { string }, station: string, selectedId: string?) -> RecipeEntry?,
	GetStartStation: (self: RecipesRegistry, entry: RecipeEntry) -> GameTypes.StationKind,
	GetIcon: (self: RecipesRegistry, entry: RecipeEntry) -> string,
	GetUnlockedAt: (self: RecipesRegistry, level: number) -> { RecipeEntry },
	GetAvailable: (self: RecipesRegistry, level: number) -> { RecipeEntry },
}
export type RecipesRegistry = Registry.Registry<RecipeEntry> & RecipesMethods

local methods: RecipesMethods = {
	-- Direct stations can prepare their sole menu recipe without taking the mixer's selection.
	GetDirectRecipe = function(
		self: RecipesRegistry,
		menu: { string },
		station: string,
		selectedId: string?
	): RecipeEntry?
		local candidate: RecipeEntry? = nil
		local count = 0
		for _, id in menu do
			local entry = self:Get(id)
			if entry and entry.mixSeconds == 0 and entry.station == station then
				if id == selectedId then
					return entry
				end
				candidate = entry
				count += 1
			end
		end
		return if count == 1 then candidate else nil
	end,

	-- The station a recipe STARTS on: almost everything starts on the mixer, coffee starts on its own.
	-- Both sides need this rule, so it lives here rather than in a handler.
	GetStartStation = function(_self: RecipesRegistry, entry: RecipeEntry): GameTypes.StationKind
		return if entry.mixSeconds > 0 then "Mixer" else entry.station
	end,

	-- The recipe's own icon, or its station's while the art is not drawn.
	GetIcon = function(_self: RecipesRegistry, entry: RecipeEntry): string
		return entry.icon or STATION_ICONS[entry.station] or ""
	end,

	-- Recipes unlocked by one specific level.
	GetUnlockedAt = function(self: RecipesRegistry, level: number): { RecipeEntry }
		return self:Query()
			:Where(function(entry: RecipeEntry)
				return entry.unlockLevel == level
			end)
			:ToArray()
	end,

	-- Everything available to a player of that level.
	GetAvailable = function(self: RecipesRegistry, level: number): { RecipeEntry }
		return self:Query()
			:Where(function(entry: RecipeEntry)
				return entry.unlockLevel <= level
			end)
			:ToArray()
	end,
}

local RecipesRegistry: RecipesRegistry = Registry.Build("Recipes", list, methods)

return RecipesRegistry
